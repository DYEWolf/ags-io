{
  "name": "ags-io",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm db:migrate && vite dev",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "vite build && pnpm build:node",
    "build:node": "node scripts/build-node.mjs",
    "start": "node --enable-source-maps dist/node/web.mjs",
    "start:worker": "node --enable-source-maps dist/node/worker.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:studio": "drizzle-kit studio",
    "auth:check": "auth check schema --config src/server/auth.ts",
    "staff:create": "tsx src/server/cli/create-staff.ts",
    "spend:demo": "tsx scripts/spend-demo.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@node-rs/argon2": "^2.2.2",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.0",
    "pino": "^10.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-qr-code": "^2.2.0",
    "srvx": "^1.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lefthook": "^2.2.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3"
  }
}
