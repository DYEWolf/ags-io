# Copia este archivo a `.env` (permisos 600, nunca se commitea — R-073).

# --- Postgres (docker compose) ---
POSTGRES_USER=ags
POSTGRES_DB=ags
POSTGRES_PASSWORD=cambia-esto-por-un-secreto-largo

# --- App ---
# Desde el host (pnpm dev / pnpm db:*): Postgres publicado en 127.0.0.1:5432 por docker-compose.override.yml.
# Dentro de compose, web y worker reciben su propia DATABASE_URL apuntando al servicio `postgres`.
DATABASE_URL=postgres://ags:cambia-esto-por-un-secreto-largo@127.0.0.1:5432/ags
DB_POOL_MAX=5
LOG_LEVEL=info
PORT=3000
