# Copia este archivo a `.env` (permisos 600, nunca se commitea — R-073).

# --- Postgres (docker compose) ---
POSTGRES_USER=ags
POSTGRES_DB=ags
POSTGRES_PASSWORD=cambia-esto-por-un-secreto-largo

# --- App ---
# Desde el host (pnpm dev / pnpm db:*): Postgres publicado en 127.0.0.1:5432 por docker-compose.override.yml.
# Dentro de compose, web y worker reciben su propia DATABASE_URL apuntando al servicio `postgres`.
DATABASE_URL=postgres://ags:cambia-esto-por-un-secreto-largo@127.0.0.1:5432/ags
DB_POOL_MAX=5
LOG_LEVEL=info
PORT=3000

# --- Auth y correo (M2) ---
# URL pública de la app (enlaces de los correos). En producción, https://<dominio>.
APP_URL=http://localhost:3000
# Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Rangos CIDR del proxy de confianza (red de Caddy), separados por comas. Vacío en desarrollo.
TRUSTED_PROXY_CIDRS=
# mailpit (desarrollo, bandeja en http://localhost:8025) | resend (producción)
EMAIL_PROVIDER=mailpit
EMAIL_FROM=ags-io <no-reply@localhost>
MAILPIT_URL=http://127.0.0.1:8025
RESEND_API_KEY=

# --- Auditoría (M8) ---
# Caracteres mínimos de texto principal en el HTML sin JavaScript (regla thin_content).
AUDIT_MIN_TEXT_CHARS=250
# PageSpeed Insights API (Google Cloud → APIs y servicios → Credenciales). Restríngela a esa API.
PAGESPEED_API_KEY=

# --- Colectores (M6) ---
# Service account de Google con la Search Console API habilitada, en base64 (una línea):
#   base64 -i google-service-account.json | tr -d '\n'
# Los clientes la añaden como usuario (Restringido) en su propiedad de Search Console.
GOOGLE_SERVICE_ACCOUNT_KEY=
